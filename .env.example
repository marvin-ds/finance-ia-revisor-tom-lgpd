# Finance-IA Revisor de Tom & LGPD - Configurações de Ambiente
# Copie este arquivo para .env e configure suas variáveis

# =============================================================================
# CONFIGURAÇÕES OBRIGATÓRIAS
# =============================================================================

# Chave da API OpenAI (OBRIGATÓRIA para funcionalidades de IA)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-sua-chave-openai-aqui

# Token de autorização do serviço (OBRIGATÓRIO)
# Use um token seguro e único para seu ambiente
AUTH_TOKEN=finance-ia-reviewer-token-seguro

# =============================================================================
# CONFIGURAÇÕES DA APLICAÇÃO
# =============================================================================

# Ambiente da aplicação
FLASK_ENV=production

# Porta do serviço
PORT=5000

# Modo debug (NUNCA usar true em produção)
DEBUG=false

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# CONFIGURAÇÕES DO GUNICORN (PRODUÇÃO)
# =============================================================================

# Número de workers (recomendado: 2 * CPU cores)
GUNICORN_WORKERS=2

# Timeout das requisições (segundos)
GUNICORN_TIMEOUT=120

# Bind address
GUNICORN_BIND=0.0.0.0:5000

# =============================================================================
# CONFIGURAÇÕES OPCIONAIS
# =============================================================================

# Configurações de rate limiting (se implementado)
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=1000

# Configurações de cache (se implementado)
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL=3600

# Configurações de monitoramento
# SENTRY_DSN=https://sua-dsn-sentry.ingest.sentry.io/projeto
# ENABLE_METRICS=true

# =============================================================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# =============================================================================

# Para desenvolvimento local, você pode usar:
# FLASK_ENV=development
# DEBUG=true
# LOG_LEVEL=DEBUG

# =============================================================================
# INSTRUÇÕES DE USO
# =============================================================================

# 1. Copie este arquivo: cp .env.example .env
# 2. Configure suas chaves e tokens
# 3. Ajuste as configurações conforme seu ambiente
# 4. NUNCA commite o arquivo .env no Git

# Para Docker:
# - As variáveis serão carregadas automaticamente pelo docker-compose
# - Certifique-se de que o arquivo .env está no mesmo diretório do docker-compose.yml

# Para execução local:
# - Use python-dotenv para carregar as variáveis
# - Ou exporte manualmente: export OPENAI_API_KEY=sua-chave